# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polymarket_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=dev_password

# Canonical URL used by both the application and Alembic migrations
DATABASE_URL=postgresql+psycopg://tracker:dev_password@localhost:5432/polymarket_tracker

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Optional: Development tool ports
ADMINER_PORT=8080
REDIS_INSIGHT_PORT=5540

# Polygon RPC Configuration
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_FALLBACK_RPC_URL=https://polygon-bor.publicnode.com

# Polymarket public trade source (anonymous, read-only; no credential required)
# The tracker polls the documented public trades query near-real-time. Defaults shown.
POLYMARKET_TRADES_URL=https://data-api.polymarket.com/v2/trades
# The official v1 URL (https://data-api.polymarket.com/trades) is retired on 2026-10-24 and is
# rejected at validation with a migration message; for the official v1/v2 pair the saved
# checkpoint carries over automatically. Custom HTTP(S) proxies must serve the v2 envelope.
# all = every public participant observation (default); taker-only = the provider's taker subset
POLYMARKET_TRADES_COVERAGE=all
# Seconds between acquisition cycles (1-60). 5 s uses about 1% of the published request limit.
POLYMARKET_TRADES_POLL_INTERVAL_SECONDS=5
# Identity retention and loss-detection horizon in seconds (60-3600); not a completeness guarantee.
POLYMARKET_TRADES_RECOVERY_HORIZON_SECONDS=600
# POLYMARKET_WS_URL is deprecated: it is accepted only with a ws:// or wss:// scheme, warns at load
# and in --config-check, and is never used for acquisition. Leave it unset.

# Alert Webhooks (optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Detector Configuration (Spec 004 truthful detection contract)
# Minimum weighted risk score [0.0, 1.0] to trigger alerts (inclusive >=).
# In the default pre-T027 posture only the size group scores (ceiling 0.450),
# so the default alert path is disclosed as unreachable unless lowered (e.g. 0.40).
DETECTOR_ALERT_THRESHOLD=0.80
# Exclusive transaction-count boundary B (> 0) for low-activity proxy wallets (nonce < B).
DETECTOR_FRESH_TRANSACTION_BOUNDARY=5
# Minimum trade-notional / 24h-volume ratio (0.0, 1.0] for volume-impact scoring (strict >).
DETECTOR_SIZE_VOLUME_THRESHOLD=0.02
# Persist signal-bearing and detector-failure risk assessment rows to PostgreSQL.
DETECTOR_PERSIST_ASSESSMENTS=true
